# ---------- Obligatorio ----------
# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave
# Texto largo y aleatorio para firmar la sesión del panel (ej: openssl rand -hex 32)
SESSION_SECRET=
# Dirección pública HTTPS donde quedará publicada la app (sin / final)
BASE_URL=https://tu-rifa.com

# ---------- Mercado Pago ----------
# Access Token de PRODUCCIÓN: Mercado Pago Developers → Tus integraciones → tu app → Credenciales de producción
# Si lo dejas vacío, la app funciona en modo simulación (pagos de prueba).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks → "Clave secreta")
MP_WEBHOOK_SECRET=
# true para usar el checkout de pruebas (sandbox) con credenciales de prueba
MP_USE_SANDBOX=false

# ---------- Correo (SMTP) ----------
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 y una "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gran Rifa <tu-correo@gmail.com>"
# Correo que recibe el aviso de cada venta (también se puede configurar en el panel)
ADMIN_EMAIL=

# ---------- Servidor ----------
PORT=3000
# Carpeta para la base de datos y las imágenes. En la nube debe ser un disco persistente.
DATA_DIR=./data
NODE_ENV=production
